tamanhoVetor = 18000; %Cortando uma parte do sinal
plot(tempo_s(1:tamanhoVetor), temperatura_C(1:tamanhoVetor));
fftECG = fft(temperatura_C(1:tamanhoVetor)); %FFT mostra o sinal que a gente consiga interpretar

fsa = 1000;
fz = (linspace(0,fsa,tamanhoVetor)); %Criando o eixo das frequencias

%modulo da fft
figure()


plot(fz,abs(fftECG)/tamanhoVetor);
%%%fdatool - ferramenta de projeto de filtro

sinalFiltrado= filter(Hd,[temperatura_C; tempo_s]); %aplica convolução no filtro
figure()
plot(sinalFiltrado(1:tamanhoVetor,1),sinalFiltrado(1:tamanhoVetor,2));



